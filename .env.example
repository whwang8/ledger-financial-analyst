# Copy to .env.local. Keep API keys server-side; never commit .env.local.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Leave empty to use the provider default. Override for your account's access.
LLM_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Opt in to live paid inference after configuring a key.
ENABLE_LIVE_LLM=true
